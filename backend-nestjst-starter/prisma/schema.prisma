generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ============ Enum ============

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED // thanh toán online thất bại (thêm cuối enum)
}

enum OrderStatus {
  PENDING // vừa đặt, chờ xử lý
  CONFIRMED // Staff đã xác nhận (đang giữ chỗ, chưa trừ kho thật)
  SHIPPING // đã giao cho vận chuyển, trừ kho thật ở bước CONFIRMED -> SHIPPING
  COMPLETED // giao thành công
  CANCELLED // đã hủy
  RETURNED // hàng hoàn về (chưa triển khai, để lần sau)
  PENDING_PAYMENT // đơn online chờ thanh toán (chưa dùng ở bản COD; thêm cuối enum)
}

enum DiscountType {
  PERCENT // giảm theo phần trăm của subtotal
  FIXED // giảm số tiền cố định (VND)
}

enum MediaAssetKind {
  PRODUCT // ảnh sản phẩm
  AVATAR // ảnh đại diện
}

enum MediaAssetStatus {
  ACTIVE // đang dùng hoặc vừa tải lên, chưa gắn
  PENDING_DELETE // không còn ai tham chiếu, chờ xóa phía kho lưu trữ (thử lại nếu lỗi)
  DELETED // đã xóa phía kho lưu trữ (giữ dòng để truy vết)
}

// ============ User ============

model User {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique
  password             String
  name                 String?
  phone                String?
  avatarUrl            String?              @db.VarChar(500) // URL ảnh đại diện (ghi kép cùng avatarAssetId: bằng media_assets.secureUrl); null = chưa có
  avatarAssetId        Int? // ảnh đại diện đã đăng ký (media_assets); null nếu chưa có ảnh
  avatarAsset          MediaAsset?          @relation("UserAvatarAsset", fields: [avatarAssetId], references: [id], onDelete: Restrict)
  role                 Role                 @default(CUSTOMER)
  isActive             Boolean              @default(true)
  cart                 Cart?
  orders               Order[]              @relation("OrderCustomer") // đơn do user này đặt
  handledOrders        Order[]              @relation("OrderHandler") // đơn user này (Staff) phụ trách
  orderStatusHistories OrderStatusHistory[] // các lần user này đổi trạng thái đơn
  resolvedPayments     PaymentTransaction[] @relation("PaymentResolver") // giao dịch thanh toán user (admin) này đã xử lý
  stockMovements       StockMovement[] // các lần đổi tồn kho do user này thực hiện
  wishlistItems        WishlistItem[] // sản phẩm yêu thích của user
  uploadedAssets       MediaAsset[]         @relation("MediaAssetUploader") // ảnh user này đã tải lên
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@map("users")
}

// ============ Sản phẩm ============

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  slug     String     @unique
  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id            Int              @id @default(autoincrement())
  name          String
  slug          String           @unique
  description   String?          @db.Text
  price         Int // giá niêm yết, VND
  imageUrl      String?          @db.VarChar(500) // DEPRECATED: chỉ để tương thích, nguồn thật là images (imageUrl = ảnh đầu, đồng bộ khi ghi)
  isActive      Boolean          @default(true)
  categoryId    Int
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  wishlistItems WishlistItem[] // khách đã thêm sản phẩm này vào yêu thích
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId, isActive])
  @@map("products")
}

// Ảnh sản phẩm, tối đa 6 ảnh/sản phẩm (kiểm ở service). sortOrder nhỏ nhất là ảnh đại diện.
// Ngoại lệ với quy ước "không cấu hình onDelete": ảnh là bảng con thuần túy nên xóa theo sản phẩm (Cascade).
model ProductImage {
  id        Int         @id @default(autoincrement())
  productId Int
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String      @db.VarChar(500) // ghi kép: bằng media_assets.secureUrl khi có assetId; ảnh URL ngoài thì assetId = null
  assetId   Int? // ảnh đã đăng ký (media_assets); Restrict: không xóa dòng asset khi còn ảnh dùng
  asset     MediaAsset? @relation(fields: [assetId], references: [id], onDelete: Restrict)
  sortOrder Int
  createdAt DateTime    @default(now())

  @@index([productId, sortOrder])
  @@index([assetId])
  @@map("product_images")
}

// Sản phẩm yêu thích của khách (theo SẢN PHẨM, không theo biến thể). Tối đa 100 mục/khách (kiểm ở service).
// Ngoại lệ "không cấu hình onDelete" (cùng ProductImage): dòng wishlist vô nghĩa khi thiếu user hoặc sản phẩm,
// nên xóa theo (Cascade). User và Product vẫn không bị xóa cứng.
model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("wishlist_items")
}

model ProductVariant {
  id             Int             @id @default(autoincrement())
  productId      Int
  product        Product         @relation(fields: [productId], references: [id])
  sku            String          @unique
  size           String
  color          String
  colorHex       String?         @db.VarChar(7) // "#RRGGBB" in hoa hoặc NULL; CHECK ở migration (chk_product_variants_color_hex)
  stock          Int             @default(0) // tồn thực tế trong kho
  reserved       Int             @default(0) // đang giữ cho đơn chưa xuất kho
  minStock       Int             @default(0) // ngưỡng cảnh báo sắp hết
  isActive       Boolean         @default(true)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

// Lịch sử thay đổi tồn thực tế (stock). Chỉ ghi khi stock đổi; giữ/nhả chỗ (reserved) không ghi.
// Thêm giá trị enum mới (SALE, RETURN...) chỉ được thêm vào CUỐI, không đổi thứ tự hay xóa.
enum StockMovementType {
  IMPORT // nhập kho
  EXPORT // xuất kho thủ công (hỏng, mất, khác)
  ADJUST // điều chỉnh theo số đếm thực tế
  SALE // xuất kho theo đơn khi chuyển SHIPPING (giảm cả stock và reserved)
}

// Trạng thái một giao dịch thanh toán online (bảng PaymentTransaction)
enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  NEEDS_REVIEW // đã nhận tiền nhưng chưa xác nhận đơn (thiếu tiền, không khớp, đơn đã đóng); admin xử lý (thêm cuối enum)
}

// Lý do một giao dịch cần admin xem lại (cột reviewReason của PaymentTransaction)
enum PaymentReviewReason {
  UNMATCHED // không tìm thấy đơn theo nội dung chuyển khoản
  UNDERPAID // chuyển thiếu tiền, không xác nhận
  OVERPAID // chuyển thừa tiền, đã xác nhận đơn, admin xem để hoàn phần thừa
  ORDER_CLOSED // đơn đã hủy/hết hạn, không mở lại
  DUPLICATE_PAID // đơn đã thanh toán rồi, nhận thêm một khoản nữa
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  variantId   Int
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  type        StockMovementType
  quantity    Int // delta có dấu: nhập +n, xuất -n, điều chỉnh = số đếm - tồn cũ
  stockBefore Int
  stockAfter  Int
  reason      String? // EXPORT: mã DAMAGED/LOST/OTHER; ADJUST: lý do tự do; IMPORT: null
  note        String?           @db.VarChar(500)
  createdById Int
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

// ============ Giỏ hàng ============

model Cart {
  id     Int        @id @default(autoincrement())
  userId Int        @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id])
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ============ Voucher ============

model Voucher {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Int // PERCENT: số nguyên phần trăm (10 = 10%); FIXED: số tiền VND
  maxDiscount   Int? // mức giảm tối đa (VND), chỉ áp dụng cho PERCENT
  minOrderValue Int          @default(0) // subtotal tối thiểu để áp mã
  usageLimit    Int? // tổng số lượt dùng; để trống = không giới hạn
  usedCount     Int          @default(0) // số lượt đã dùng (đơn bị hủy thì trừ lại)
  startsAt      DateTime
  expiresAt     DateTime
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("vouchers")
}

// ============ Đơn hàng ============

model Order {
  id                  Int                  @id @default(autoincrement())
  code                String               @unique // ví dụ DH20260930-0001
  userId              Int? // null = guest checkout
  user                User?                @relation("OrderCustomer", fields: [userId], references: [id])
  handledById         Int? // Staff phụ trách, gán khi xác nhận đơn
  handledBy           User?                @relation("OrderHandler", fields: [handledById], references: [id])
  customerName        String // tên người nhận
  customerPhone       String // số điện thoại người nhận
  customerEmail       String?
  shippingAddress     String               @db.VarChar(500) // chuỗi địa chỉ ghép đầy đủ (để in phiếu)
  // Địa chỉ giao hàng chụp lại theo đơn vị hành chính (mã + tên từng cấp). Nullable ở DB vì đơn cũ không có;
  // DTO/service bắt buộc đủ cho đơn mới.
  provinceCode        String?              @db.VarChar(10)
  provinceName        String?
  districtCode        String?              @db.VarChar(10)
  districtName        String?
  wardCode            String?              @db.VarChar(10)
  wardName            String?
  addressLine         String?              @db.VarChar(255) // số nhà, đường
  note                String?              @db.VarChar(500)
  subtotal            Int
  shippingFee         Int                  @default(0)
  voucherId           Int? // null = không dùng voucher
  voucher             Voucher?             @relation(fields: [voucherId], references: [id])
  voucherCode         String?              @db.VarChar(50) // chụp lại mã voucher (voucherId là SET NULL nếu voucher bị xóa)
  discountAmount      Int                  @default(0) // số tiền giảm từ voucher, không vượt subtotal
  totalAmount         Int // = subtotal + shippingFee - discountAmount
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus        @default(UNPAID)
  paymentRef          String? // mã giao dịch của cổng thanh toán
  paidAt              DateTime?
  paymentExpiresAt    DateTime? // hạn thanh toán của đơn online
  status              OrderStatus          @default(PENDING)
  cancelReason        String?              @db.VarChar(500)
  idempotencyKey      String?              @db.VarChar(64) // header Idempotency-Key của POST /orders; null = không gửi
  items               OrderItem[]
  statusHistories     OrderStatusHistory[]
  paymentTransactions PaymentTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id            Int            @id @default(autoincrement())
  orderId       Int
  order         Order          @relation(fields: [orderId], references: [id])
  variantId     Int
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  productName   String // snapshot lúc mua
  sku           String // snapshot
  size          String // snapshot
  color         String // snapshot
  colorHex      String?        @db.VarChar(7) // snapshot
  imageUrl      String?        @db.VarChar(500) // snapshot ảnh đầu (product_images.url) lúc mua
  imagePublicId String?        @db.VarChar(255) // snapshot publicId của ảnh đầu (collation utf8mb4_bin thêm tay ở migration); chặn xóa asset còn được đơn cũ tham chiếu

  quantity Int
  price    Int // snapshot đơn giá lúc mua

  @@index([imagePublicId])
  @@map("order_items")
}

// Lịch sử đổi trạng thái đơn: ai đổi, khi nào, lý do. actorId null = hệ thống (vd tự hủy đơn hết hạn).
model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus? // null = dòng đầu tiên (tạo đơn)
  toStatus   OrderStatus
  actorId    Int?
  actor      User?        @relation(fields: [actorId], references: [id])
  reason     String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

// Giao dịch thanh toán online: mỗi lần nhận tiền (webhook đối soát) hoặc admin xác nhận thủ công là một dòng.
// provider = nguồn đối soát (SEPAY, MANUAL...). orderId null = giao dịch không khớp đơn nào.
model PaymentTransaction {
  id             Int                      @id @default(autoincrement())
  orderId        Int?
  order          Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider       String                   @db.VarChar(20) // SEPAY, MANUAL...
  providerTxnId  String?                  @db.VarChar(100) // mã giao dịch phía nhà cung cấp (null với MANUAL)
  amount         Int // VND
  content        String?                  @db.VarChar(500) // nội dung chuyển khoản gốc
  status         PaymentTransactionStatus @default(PENDING)
  reviewReason   PaymentReviewReason? // khác null = cần admin xem (cho tới khi resolvedAt có giá trị)
  resolvedAt     DateTime?
  resolvedById   Int?
  resolvedBy     User?                    @relation("PaymentResolver", fields: [resolvedById], references: [id])
  resolutionNote String?                  @db.VarChar(500)
  rawData        Json? // dữ liệu thô callback, để đối soát
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([provider, providerTxnId]) // callback idempotent
  @@index([orderId])
  @@index([reviewReason, resolvedAt])
  @@map("payment_transactions")
}

// Ảnh đã tải lên Cloudinary. Dòng này KHÔNG bị xóa cứng: xóa ảnh = status DELETED.
// uploadedById: SetNull có chủ ý. User không bị xóa cứng; nếu có xóa thì ảnh vẫn tồn tại và vẫn được dọn đúng, chỉ mất thông tin người tải.
// publicId phân biệt hoa/thường như Cloudinary nên cột dùng collation utf8mb4_bin (sửa tay ở migration; Prisma không biểu diễn được).
model MediaAsset {
  id             Int              @id @default(autoincrement())
  publicId       String           @unique @db.VarChar(255)
  secureUrl      String           @db.VarChar(500) // URL gốc, không kèm biến đổi
  width          Int?
  height         Int?
  format         String?          @db.VarChar(10)
  bytes          Int?
  kind           MediaAssetKind
  status         MediaAssetStatus @default(ACTIVE)
  uploadedById   Int?
  uploadedBy     User?            @relation("MediaAssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  deleteAttempts Int              @default(0)
  lastError      String?          @db.VarChar(500)
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  productImages  ProductImage[]
  avatarUsers    User[]           @relation("UserAvatarAsset")

  @@index([status, createdAt])
  @@index([uploadedById, createdAt])
  @@map("media_assets")
}
