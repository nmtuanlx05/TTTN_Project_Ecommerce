# Sao chép file này thành .env.development (chạy local) hoặc .env.production (chạy production) rồi đổi giá trị.
# App chọn file theo NODE_ENV: không đặt hoặc development -> .env.development, production -> .env.production.
# KHÔNG đặt mật khẩu thật vào file này.

# Dùng bởi docker-compose.yml để khởi tạo MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ecommerce_dev
MYSQL_USER=ecommerce
MYSQL_PASSWORD=change_me

# Dùng bởi Prisma (prisma.config.ts). Phải khớp các giá trị MYSQL_* ở trên:
# mysql://<MYSQL_USER>:<MYSQL_PASSWORD>@localhost:3307/<MYSQL_DATABASE>
DATABASE_URL="mysql://ecommerce:change_me@localhost:3307/ecommerce_dev"

# ---- Auth (JWT) ----
# Bắt buộc: thiếu biến nào app báo lỗi và không khởi động. Hai secret phải khác nhau.
# Tạo secret ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Chỉ dùng bởi `npx prisma db seed` để tạo tài khoản ADMIN đầu tiên (bỏ qua nếu email đã tồn tại)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin

# ---- Upload ảnh (tùy chọn: bỏ trống thì dùng giá trị mặc định dưới đây) ----
# Thư mục lưu ảnh (tương đối so với thư mục chạy backend, hoặc đường dẫn tuyệt đối). Khi triển khai bằng Docker nên mount volume vào đây.
UPLOAD_DIR=uploads
# URL công khai của backend, dùng ghép URL ảnh trả về (<APP_PUBLIC_URL>/uploads/...). Phải khớp PORT nếu đổi cổng.
# Tối đa 132 ký tự, không có dấu / cuối.
APP_PUBLIC_URL=http://localhost:3000

# ---- Thanh toán online: chuyển khoản VietQR (tùy chọn) ----
# Thiếu hoặc sai một trong VIETQR_BANK_BIN / VIETQR_ACCOUNT_NO / VIETQR_ACCOUNT_NAME (hoặc PAYMENT_EXPIRE_MINUTES) thì app VẪN khởi động,
# lựa chọn ONLINE bị tắt và log cảnh báo nêu tên biến. KHÔNG đặt giá trị thật vào file này; đặt vào .env.development / .env.production.
# BIN ngân hàng nhận tiền (6 chữ số, ví dụ MB là 970422)
VIETQR_BANK_BIN=
# Số tài khoản nhận tiền (6-19 chữ số)
VIETQR_ACCOUNT_NO=
# Tên chủ tài khoản hiển thị cho khách (viết hoa, không dấu)
VIETQR_ACCOUNT_NAME=
# Tùy chọn: ghi đè tên ngân hàng hiển thị (mặc định tra theo BIN)
VIETQR_BANK_NAME=
# Số phút khách có để chuyển khoản trước khi đơn tự hủy (1-1440, mặc định 30)
PAYMENT_EXPIRE_MINUTES=
# Khóa API của webhook SePay (SePay gửi "Authorization: Apikey <khóa>"). Bỏ trống = webhook tắt hẳn (trả 404).
# Tạo khóa ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEPAY_WEBHOOK_API_KEY=

# --- Lưu trữ ảnh (xem docs/cloudinary-setup.md); chỉ ghi giá trị thật vào .env.development / .env.production ---
# cloudinary (mặc định) hoặc local (chỉ test/CI/dev offline)
STORAGE_DRIVER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục gốc theo môi trường, vd mono-studio/development (bỏ trống thì tự đặt theo NODE_ENV)
CLOUDINARY_FOLDER_PREFIX=
# Hạn mức tải ảnh mỗi người dùng trong 24 giờ
MEDIA_QUOTA_PRODUCTS_PER_DAY=
MEDIA_QUOTA_AVATARS_PER_DAY=
# false = không nhận ảnh sản phẩm từ URL ngoài (khuyến nghị ở production)
ALLOW_EXTERNAL_IMAGE_URLS=
# Tác vụ dọn ảnh định kỳ: false để tắt; số giờ tối thiểu trước khi ảnh chưa gắn bị coi là mồ côi
MEDIA_CLEANUP_ENABLED=
MEDIA_ORPHAN_MIN_AGE_HOURS=
